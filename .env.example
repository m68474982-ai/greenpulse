# EcoShield AI Backend Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://ecoshield:ecoshield123@localhost:5432/ecoshield_db
DATABASE_URL_SYNC=postgresql://ecoshield:ecoshield123@localhost:5432/ecoshield_db

# JWT
SECRET_KEY=ecoshield-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MQTT (optional - for real IoT hardware)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ecoshield/sensors

# Redis (optional - for pub/sub)
REDIS_URL=redis://localhost:6379

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo
DEMO_MODE=true
SIMULATION_INTERVAL=5
